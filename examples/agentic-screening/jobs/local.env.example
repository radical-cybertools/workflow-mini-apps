# The site's settings for jobs/scale (jobs/README.md). Copy to jobs/local.env (ignored by git), or keep
# one file per site anywhere and name it in AUTONMI_LOCAL_ENV. The jobs source this file in bash, so it
# can also set PATH or load modules. Write a value as ${NAME:-value} to let the environment change it
# for one run.

# Paths, written out in full
AUTONMI_VENV=/path/to/venv            # Python 3.12 with the AUTONMI framework, Dragon, RaDEX, RHAPSODY, Flowgentic
AUTONMI_OVERLAY=                      # optional: directories put on PYTHONPATH after this tree's src
AUTONMI_RUNS=/path/to/runs            # run directories, on a file system the nodes share
AUTONMI_MODEL_VENV=                   # optional: the model job's environment, with vLLM (default AUTONMI_VENV)
AUTONMI_MODEL=${AUTONMI_MODEL:-/path/to/Qwen3-8B}  # the model's weights
AUTONMI_CUDART=                       # optional: on LD_LIBRARY_PATH, so that Dragon sees the GPUs

# Slurm
SLURM_ACCOUNT=                        # optional where jobs need no account
SLURM_CPU_PARTITION=
SLURM_GPU_PARTITION=
SLURM_GPU_GRES=gpu:1                  # must end in a count, which the rung's GPUs replace; empty: no --gres
# AUTONMI_QOS_TEST=                   # the QOS of the small jobs (the test and the report), the campaign
# AUTONMI_QOS_CAMPAIGN=               # and the model job
# AUTONMI_QOS_MODEL=
# AUTONMI_SBATCH_CAMPAIGN=            # more sbatch options for the campaign and for the model job, such as
# AUTONMI_SBATCH_MODEL=               # --exclude, --constraint or --reservation (word-split)
# AUTONMI_DRAGON_SINGLETON=1         # 0: the Dragon jobs (test, campaign) do not wait for each other

# The CPU nodes
AUTONMI_NODE_MEM=                     # memory to ask for on each CPU node, such as 300G
# AUTONMI_NODE_CPUS=96                # CPUs to ask for on each node; the populations' workers share them
# AUTONMI_NODE_EXCLUSIVE=1            # 0: share the nodes (where a limit on CPUs per user forbids whole nodes)
# AUTONMI_NODE_POPULATIONS=2          # populations of agents per node
# AUTONMI_NODE_RESERVE=8              # CPUs left for the populations' own processes, the store and the services
# AUTONMI_NODE_WORKERS=               # simulation workers per population, one CPU each
#                                       (default: (CPUS - RESERVE) / POPULATIONS, 44 on 96 CPUs)

# Dragon across nodes (rungs of 2 nodes or more): the launcher's options, as a bash array, such as the
# workload manager, the transport and the network the nodes reach each other on. One node runs
# `dragon -s` and ignores it. For example:
# AUTONMI_DRAGON_ARGS=(-w slurm -t tcp --network-prefix '^ib\w*$')

# The model servers (Qwen3-8B's settings when unset)
# AUTONMI_MODEL_NAME=Qwen3-8B          # the served name, which the mini-app's --model-name gets too
# AUTONMI_TOOL_PARSER=hermes           # vLLM's tool-call parser
# AUTONMI_REASONING=qwen3              # vLLM's reasoning parser; unset: thinking off
# AUTONMI_TP=1                         # GPUs per vLLM server (tensor parallel), for a model larger than one GPU
# AUTONMI_VLLM_ARGS=                   # more of vLLM's options
# AUTONMI_GPU_VARIABLE=CUDA_VISIBLE_DEVICES  # the variable that pins a server to its GPUs
# AUTONMI_GPU_CPUS=12                  # the model job's CPUs per GPU
# AUTONMI_GPU_MEM_GB=110               # and memory per GPU
# AUTONMI_CAP_TOKENS=                  # tokens of live context in flight per server, for the GPU's memory
# AUTONMI_MODEL_WAIT=                  # seconds the campaign waits for every server (600, and 300 per server)
# AUTONMI_ENDPOINT_HOST=%h              # the servers' host for the campaign's nodes: %h short name, %f full
# export HF_HUB_OFFLINE=1              # where compute nodes have no internet

# More of the mini-app's options for every campaign (word-split), such as --span-ratio 1
# AUTONMI_CAMPAIGN_ARGS=

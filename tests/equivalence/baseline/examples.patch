     flow = await WorkflowEngine.create(backend=backend)
+    input_size = max(e["read_size_bytes"] for e in cfg["stages"] + [cfg["analysis"]])
+    kern.writeNonMPI(num_bytes=input_size, data_root_dir="./")
 
     @flow.function_task
     async def simulate(stage_idx, candidate):
@@ -40,7 +42,7 @@
